    {
      "id": 9,
      "type": "timeseries",
      "title": "Tokens par heure, par fournisseur",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (provider, direction) (increase(snowfall_llm_tokens_total[1h]))",
          "legendFormat": "{{provider}} {{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
