{
  "name": "snowfall",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @snowfall/web",
    "build:web": "npm run build -w @snowfall/web",
    "lint:web": "npm run lint -w @snowfall/web",
    "dev:api": "npm run dev -w @snowfall/api",
    "check:api": "npm run check -w @snowfall/api",
    "check": "npm run check:api && npm run lint:web && npm run build:web",
    "db:generate": "drizzle-kit generate --config apps/api/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config apps/api/drizzle.config.ts",
    "db:check": "drizzle-kit check --config apps/api/drizzle.config.ts"
  }
}
