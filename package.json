{
  "name": "snowfall",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @snowfall/web",
    "build:web": "npm run build -w @snowfall/web",
    "lint:web": "npm run lint -w @snowfall/web",
    "dev:api": "npm run dev -w @snowfall/api",
    "check:api": "npm run check -w @snowfall/api",
    "check": "npm run check:api && npm run lint:web && npm run build:web",
    "db:generate": "npm run db:generate -w @snowfall/api",
    "db:migrate": "npm run db:migrate -w @snowfall/api",
    "db:check": "npm run db:check -w @snowfall/api",
    "db:setup": "npm run db:setup -w @snowfall/api",
    "keys:rotate": "npm run keys:rotate -w @snowfall/api --",
    "audit:purge": "npm run audit:purge -w @snowfall/api --",
    "knowledge:eval": "npm run knowledge:eval -w @snowfall/api --",
    "keycloak:sync": "npm run keycloak:sync -w @snowfall/api"
  },
  "dependencies": {
    "country-flag-icons": "^1.6.20"
  },
  "overrides": {
    "@napi-rs/canvas": "1.0.9"
  }
}
