# Fichiers exécutés dans des conteneurs Linux : toujours en fins de ligne LF,
# quel que soit le poste qui les a modifiés.
*.sh          text eol=lf
*.conf        text eol=lf
*.hcl         text eol=lf
*.alloy       text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
Dockerfile    text eol=lf
infra/**      text=auto eol=lf
# Catalogue d'agents : contenu mesuré et comparé à l'octet près (script Python compris).
apps/api/catalog/**  text eol=lf
