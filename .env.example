# Mots de passe et secrets (hexadécimal, sûr dans les URLs) :
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# SNOWFALL_MASTER_KEY (32 octets en base64) :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# En production : secrets injectés par un gestionnaire (Vault, KMS…), jamais de .env.

# --- PostgreSQL ---------------------------------------------------------------
# Superutilisateur : uniquement pour npm run db:setup et les opérations d'exploitation.
SNOWFALL_DB_PASSWORD=change_me_superuser_password
DATABASE_ADMIN_URL=postgresql://snowfall:change_me_superuser_password@127.0.0.1:5434/snowfall
# Propriétaire du schéma : migrations et bootstrap.
DATABASE_MIGRATION_URL=postgresql://snowfall_migrator:change_me_migrator_password@127.0.0.1:5434/snowfall
# Rôle applicatif : droits minimaux, soumis à la RLS.
# En production, ajouter ?sslmode=verify-full&sslrootcert=/chemin/ca.crt (exigé).
DATABASE_URL=postgresql://snowfall_app:change_me_app_password_123@127.0.0.1:5434/snowfall
KEYCLOAK_DB_PASSWORD=change_me_keycloak_db_password

# --- Keycloak / OIDC (BFF) ----------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_admin_password
OIDC_ISSUER=http://localhost:8080/realms/snowfall
OIDC_CLIENT_ID=snowfall-bff
# 32 caractères minimum ; injecté aussi dans le realm Keycloak à l'import.
OIDC_CLIENT_SECRET=change_me_with_openssl_rand_base64_32
APP_ORIGIN=http://localhost:5173
# "organization" : SSO par organisation (Entra ID, Google Workspace via les
# organisations Keycloak). Exige le scope assigné au client : npm run keycloak:sync.
OIDC_EXTRA_SCOPES=
# Utilisés par npm run keycloak:sync (realm déjà importé).
KEYCLOAK_URL=http://localhost:8080
# URL de l'API vue par Keycloak pour la déconnexion back-channel.
SNOWFALL_BACKCHANNEL_LOGOUT_URL=http://host.docker.internal:3001/auth/backchannel-logout

# --- E-mails (Keycloak : vérification, mot de passe oublié) -----------------
# Développement : Mailpit (docker compose), interface sur http://localhost:8025.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@snowfall.local
SMTP_FROM_NAME=Snowfall
SMTP_STARTTLS=false
SMTP_SSL=false
# Production : serveur SMTP authentifié, STARTTLS ou TLS obligatoire.
SMTP_USER=
SMTP_PASSWORD=

# --- Chiffrement --------------------------------------------------------------
# Clé maîtresse (32 octets base64). Sa perte rend les données illisibles :
# la sauvegarder hors de la base, séparément des sauvegardes de données.
SNOWFALL_MASTER_KEY=
# Clés des organisations (DEK) enveloppées par : "local" (KEK dérivée de la clé
# maîtresse) ou "vault" (HashiCorp Vault / OpenBao Transit, recommandé en
# production). Clé Transit : type aes256-gcm96, derived=true. Bascule et
# rotation : npm run keys:rotate -- --kek
KMS_PROVIDER=local
VAULT_ADDR=
VAULT_TOKEN=
VAULT_NAMESPACE=
VAULT_TRANSIT_MOUNT=transit
VAULT_TRANSIT_KEY=snowfall

# --- Journal d'audit ------------------------------------------------------
# Une ligne JSON par événement sur la sortie de l'API (collecte Vector, Fluent Bit…).
AUDIT_STDOUT=true
# Envoi direct vers un SIEM (HTTPS en production) : "json" ou "splunk-hec".
SIEM_WEBHOOK_URL=
SIEM_WEBHOOK_TOKEN=
SIEM_FORMAT=json
# Conservation en base avant purge (npm run audit:purge), 90 jours minimum.
AUDIT_RETENTION_DAYS=365

# --- LLM ----------------------------------------------------------------------
# Un fournisseur n'apparaît dans le studio d'agents que si sa clé est fournie.
# Les modèles proposés sont lus en direct auprès de chaque fournisseur.
MISTRAL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Google AI Studio (Gemini) : https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Serveur local compatible OpenAI (Ollama : http://localhost:11434/v1, vLLM…).
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
# Modèle des conversations sans agent, "fournisseur:modèle". Vide = Mistral
# (MISTRAL_MODEL) si sa clé existe, sinon modèle "echo" local (dev uniquement).
# Obligatoire en production.
LLM_DEFAULT_MODEL=
MISTRAL_MODEL=mistral-small-latest
# Inclut le raisonnement des modèles qui réfléchissent avant de répondre.
LLM_MAX_OUTPUT_TOKENS=16000
LLM_TIMEOUT_MS=60000

# --- Bases de connaissances -------------------------------------------------
# Modèles d'embeddings par fournisseur (l'organisation choisit le fournisseur
# dans les réglages ; par défaut aucun : recherche par mots-clés, rien ne sort).
EMBEDDING_MODEL_MISTRAL=mistral-embed
EMBEDDING_MODEL_OPENAI=text-embedding-3-small
EMBEDDING_MODEL_GOOGLE=gemini-embedding-001
# Embeddings locaux (Ollama, vLLM) via LOCAL_LLM_BASE_URL, ex. bge-m3. Requis
# pour les embeddings des bases confidentielles.
LOCAL_EMBEDDING_MODEL=
# Import de pages web (off si la plateforme n'a pas de sortie Internet contrôlée).
KNOWLEDGE_LINKS=on
# Reclassement des passages (cross-encoder hébergé : vLLM / Infinity au format
# Cohere, ou Text Embeddings Inference avec RERANK_API=tei). Vide = désactivé.
RERANK_BASE_URL=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API=cohere
# local : service de la plateforme (autorisé pour les bases confidentielles).
RERANK_SCOPE=local
RERANK_MIN_SCORE=0.02

# --- Antivirus et sorties réseau ---------------------------------------------
# ClamAV : actif par défaut en production (fichier refusé si l'analyse est
# impossible). En développement : docker compose --profile antivirus up -d
# clamav, puis ANTIVIRUS=clamav et CLAMAV_HOST=localhost.
ANTIVIRUS=off
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# Proxy de sortie pour l'import de liens (compose.prod : http://egress:3128).
EGRESS_PROXY_URL=

# --- Réseau -------------------------------------------------------------------
# IP/CIDR des reverse proxies de confiance (vide = aucun).
TRUST_PROXY=
# Store partagé pour la limitation de débit en multi-instances (optionnel).
REDIS_URL=

# --- Sauvegardes ------------------------------------------------------------
# Clé publique age (https://age-encryption.org) des sauvegardes chiffrées.
BACKUP_AGE_RECIPIENT=

# --- Bootstrap (npm run db:bootstrap-test -w @snowfall/api) ------------------
SNOWFALL_BOOTSTRAP_SUBJECT=
SNOWFALL_BOOTSTRAP_EMAIL=test@snowfall.fr
SNOWFALL_BOOTSTRAP_ORGANIZATION=Snowfall
